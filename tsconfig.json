{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "api/**/*.js",
    "lib/**/*.js",
    "server.js",
    "test-api.js"
  ],
  "exclude": [
    "node_modules",
    "public"
  ]
}
